{
  "$description": "Dotforge design tokens (W3C Design Tokens format). Mirrors styles/tokens.css.",
  "color": {
    "mono": {
      "0":    { "$type": "color", "$value": "#FFFFFF" },
      "50":   { "$type": "color", "$value": "#F7F7F7" },
      "100":  { "$type": "color", "$value": "#EDEDED" },
      "200":  { "$type": "color", "$value": "#DADADA" },
      "300":  { "$type": "color", "$value": "#BDBDBD" },
      "400":  { "$type": "color", "$value": "#9A9A9A" },
      "500":  { "$type": "color", "$value": "#767676" },
      "600":  { "$type": "color", "$value": "#5A5A5A" },
      "700":  { "$type": "color", "$value": "#3F3F3F" },
      "800":  { "$type": "color", "$value": "#262626" },
      "900":  { "$type": "color", "$value": "#141414" },
      "1000": { "$type": "color", "$value": "#000000" }
    },
    "beige": {
      "50":  { "$type": "color", "$value": "#FBF8F2" },
      "100": { "$type": "color", "$value": "#F5EFE3" },
      "200": { "$type": "color", "$value": "#EBE1CC" },
      "300": { "$type": "color", "$value": "#DFD0B0" },
      "400": { "$type": "color", "$value": "#CDB88E" },
      "500": { "$type": "color", "$value": "#B89F70" },
      "600": { "$type": "color", "$value": "#776243" },
      "700": { "$type": "color", "$value": "#5E4C33" }
    },
    "semantic": {
      "bg":            { "$type": "color", "$value": "{color.beige.50}" },
      "surface":       { "$type": "color", "$value": "{color.mono.0}" },
      "surface-alt":   { "$type": "color", "$value": "{color.beige.100}" },
      "text":          { "$type": "color", "$value": "{color.mono.900}" },
      "text-muted":    { "$type": "color", "$value": "{color.mono.600}" },
      "border":        { "$type": "color", "$value": "{color.beige.200}" },
      "accent":        { "$type": "color", "$value": "{color.beige.400}" },
      "accent-strong": { "$type": "color", "$value": "{color.beige.600}" },
      "inverse-bg":    { "$type": "color", "$value": "{color.mono.900}" },
      "inverse-text":  { "$type": "color", "$value": "{color.beige.50}" }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"] },
    "body":    { "$type": "fontFamily", "$value": ["Manrope", "system-ui", "sans-serif"] }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "14px" },
    "lg":   { "$type": "dimension", "$value": "22px" },
    "xl":   { "$type": "dimension", "$value": "32px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "180ms" },
      "base": { "$type": "duration", "$value": "400ms" },
      "slow": { "$type": "duration", "$value": "800ms" }
    },
    "spring": {
      "stiffness": { "$type": "number", "$value": 420 },
      "damping":   { "$type": "number", "$value": 26 }
    }
  }
}
